                <input type="text" class="w-full h-16 border-none bg-gray-100 rounded-lg text-right text-2xl p-2.5 mb-4" id="display" disabled />
                <div class="grid grid-cols-4 gap-2.5">
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-red-300 hover:bg-red-400 transition-colors" onclick="clearDisplay()">C</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('/')">/</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('*')">*</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('-')">-</button>

                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('7')">7</button>
