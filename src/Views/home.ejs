                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('5')">5</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('6')">6</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-blue-400 hover:bg-blue-500 transition-colors text-white font-semibold" onclick="calculate()">=</button>

                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('1')">1</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('2')">2</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('3')">3</button>
                    <button class="h-12 border-none rounded-lg text-lg cursor-pointer bg-gray-200 hover:bg-gray-300 transition-colors" onclick="appendValue('0')">0</button>
                </div>
            </div>
        </div>
